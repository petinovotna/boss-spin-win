# === BOSS Spin & Win — proměnné prostředí ===
# Zkopíruj tento soubor jako `.env.local` a doplň skutečné hodnoty.
# `.env.local` se NIKDY necommituje (je v .gitignore).

# --- Supabase ---
# Najdeš v Supabase dashboardu: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SERVICE ROLE key — má plný přístup k DB. Používá se JEN na serveru. Nikdy ho nedávej do frontendu!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Ověřování hostesek ---
# Sdílený PIN, který hostesky zadají na /verify. Zvol něco netriviálního.
EVENT_HOSTESS_PIN=change-me-1234
# Tajný klíč pro podpis přihlašovací cookie. Vygeneruj náhodný řetězec, např.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-long-random-string
